#compdef tclrs

# Zsh completion for tclrs — Tcl compiled to fusevm bytecode.
#
# The options that do not run the script the ordinary way (--aot, --tiers, the
# dumps) each want a whole script, so they take a file; -c takes the script
# itself. `(- *)` marks the ones that end the command line.
#
# --tk is offered unconditionally, because a completion is read from a file and
# cannot know whether the binary on this machine was built with the feature.
# A build without it refuses the option like any other unknown one.

_tclrs() {
  _arguments -s \
    '(- *)'{-V,--version}'[print the version and exit]' \
    '(- *)'{-h,--help}'[print the usage and exit]' \
    '(- *)-c[run the script given here instead of a file]:script' \
    '--aot[compile the script to a standalone native executable]:output file:_files' \
    '--aot-object[emit the relocatable AOT object only]:output object:_files' \
    '--tiers[run the script, then report which fusevm tiers took its chunk]' \
    '(- *)--lsp[run the language server over stdio]' \
    '(- *)--dap[run the debug adapter over stdio]' \
    '--dump-tokens[print the parser'\''s lexical output instead of running it]' \
    '--dump-ast[print the parse tree instead of running it]' \
    '--disasm[print the compiled bytecode instead of running it]' \
    '--tk[run on the main thread, with Tk available to the script]' \
    '*:Tcl script:_files -g "*.tcl"'
}

_tclrs "$@"
